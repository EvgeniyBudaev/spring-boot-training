<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="create_cart_items_table" author="EvgeniyBudaev">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="cart_items"/>
            </not>
        </preConditions>

        <createTable tableName="cart_items">
            <column name="id" type="serial" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="cart_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="bigint">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="quantity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE cart_items ADD CONSTRAINT quantity_check CHECK (quantity >= 0);
        </sql>

        <rollback>
            <dropTable tableName="cart_items" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <changeSet id="create_cart_items_foreign_key_items" author="EvgeniyBudaev">
        <preConditions>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cart_items_item"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint baseTableName="cart_items"
                                 baseColumnNames="item_id"
                                 constraintName="fk_cart_items_item"
                                 referencedTableName="items"
                                 referencedColumnNames="id"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="cart_items" constraintName="fk_cart_items_items"/>
        </rollback>
    </changeSet>

    <changeSet id="create_cart_items_foreign_key_carts" author="EvgeniyBudaev">
        <preConditions>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cart_items_cart"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint baseTableName="cart_items"
                                 baseColumnNames="cart_id"
                                 constraintName="fk_cart_items_cart"
                                 referencedTableName="carts"
                                 referencedColumnNames="id"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="cart_items" constraintName="fk_cart_items_cart"/>
        </rollback>
    </changeSet>

<!--    Добавил уникальный индекс на (cart_id, item_id)-->
<!--    Чтобы один товар не дублировался в одной корзине-->
    <changeSet id="add_unique_cart_item" author="EvgeniyBudaev">
        <preConditions>
            <not>
                <indexExists indexName="uk_cart_item"/>
            </not>
        </preConditions>
        <createIndex tableName="cart_items" indexName="uk_cart_item" unique="true">
            <column name="cart_id"/>
            <column name="item_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
